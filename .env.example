# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
# Anthropic API key for the agent
ANTHROPIC_API_KEY=
# Optional: model override (default claude-haiku-4-5)
ANTHROPIC_MODEL=
# Optional: persistent spend + rate-limit store (Supabase). Without these, an in-memory store is used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_SECRET=
# Optional guard settings
SPEND_CAP_USD=9.0
RATE_PER_10MIN=8
RATE_PER_DAY=40
